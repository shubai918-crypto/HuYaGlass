import 'package:hive_flutter/hive_flutter.dart';

class StorageService {
  static late Box _settingsBox;
  static late Box _followBox;

  static void init() {
    _settingsBox = Hive.box('settings');
    _followBox = Hive.box('follow');
  }

  // 设置
  static T getSetting<T>(String key, {required T defaultValue}) {
    return _settingsBox.get(key, defaultValue: defaultValue) as T;
  }

  static void setSetting<T>(String key, T value) {
    _settingsBox.put(key, value);
  }

  // 关注列表
  static void addFollow(String roomId, Map<String, dynamic> data) {
    _followBox.put(roomId, data);
  }

  static void removeFollow(String roomId) {
    _followBox.delete(roomId);
  }

  static bool isFollowed(String roomId) {
    return _followBox.containsKey(roomId);
  }

  static List<Map<String, dynamic>> getAllFollows() {
    return _followBox.values
        .map((e) => Map<String, dynamic>.from(e as Map))
        .toList();
  }
}
